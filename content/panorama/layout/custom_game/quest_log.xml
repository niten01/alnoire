<root>
  <styles>
    <include src="file://{resources}/styles/custom_game/quest_log.css" />
  </styles>

  <scripts>
    <include src="file://{resources}/scripts/custom_game/quest_log.js" />
  </scripts>

  <Panel class="QuestLogRoot Collapsed">
    <Button id="QuestTab" class="QuestTab" onactivate="ToggleQuestLog()">
      <Label id="QuestTabLabel" class="QuestTabLabel" text="QUESTS" />
