    <Panel id="QuestLogPanel" class="QuestLogPanel">
      <!-- <Panel class="QuestLogHeader">
        <Label class="QuestLogTitle" text="Quests" />
      </Panel> -->

      <Label id="NoQuestsLabel" class="NoQuestsLabel" text="No active quests"></Label>
      <Panel id="QuestList" class="QuestList" />
    </Panel>
  </Panel>
</root>
